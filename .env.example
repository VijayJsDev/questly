# Copy this file to .env.development or .env.production and fill in the values.
# Never commit the actual .env files — only this example.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME=Questly
# Backend API URL. Use localhost:5000 for iOS simulator, 10.0.2.2:5000 for Android emulator, or your LAN IP (e.g. 192.168.1.x:5000) for physical devices
EXPO_PUBLIC_API_URL=http://localhost:5000
